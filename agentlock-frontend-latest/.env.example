# AgentLock Environment Configuration

# Backend FastAPI Server URL (used by Next.js server rewrite to proxy /api/* requests)
BACKEND_URL=http://localhost:8000

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://agentlock.dev

# Isolated Mock Data Toggle (Off by default. When true, loads local fallback mocks with visible badge)
NEXT_PUBLIC_USE_MOCKS=false
