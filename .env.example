# Server-only backend origin. Production must use HTTPS.
BACKEND_URL=http://127.0.0.1:8000

# Use the same exact frontend origin for both settings.
NEXT_PUBLIC_SITE_URL=http://localhost:5173
AGENTLOCK_FRONTEND_ORIGIN=http://localhost:5173

# One administrator account for this starter deployment.
AGENTLOCK_ADMIN_EMAIL=
AGENTLOCK_ADMIN_PASSWORD=
AGENTLOCK_SESSION_SECRET=

# Must match backend/.env. Leave blank until replaced with a random key.
AGENTLOCK_API_KEY=

# Set true only for isolated local mock development.
NEXT_PUBLIC_USE_MOCKS=false
